---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft && data.approved);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const author = 'Hosang Kim';
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  url: Astro.url.href,
  mainEntityOfPage: Astro.url.href,
  datePublished: post.data.pubDate.toISOString().slice(0, 10),
  inLanguage: 'en',
  author: { '@type': 'Person', name: author, url: new URL('/about/', Astro.site).href },
};
---
<Base title={`${post.data.title} · dropkit.contents`} description={post.data.description} ogType="article" articleSchema={articleSchema}>
  <p class="meta">
    <a href="/notes/">← Notes</a> · {post.data.pubDate.toISOString().slice(0, 10)} · <a href="/about/">{author}</a>
  </p>
  <h1 style="font-size:1.6rem">{post.data.title}</h1>
  <div class="prose">
    <Content />
  </div>
</Base>
