---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

function laneOf(p: (typeof posts)[number]) {
  if (p.data.lane === 'deep' || p.data.lane === 'scoreboard') return p.data.lane;
  if (p.data.tags.includes('deep')) return 'deep';
  if (p.data.tags.includes('scoreboard')) return 'scoreboard';
  return 'writing';
}

const latest = posts[0];
const rest = posts.slice(1);
const groups = [
  { id: 'deep', label: 'Deep cut', items: rest.filter((p) => laneOf(p) === 'deep') },
  { id: 'scoreboard', label: 'Scoreboard', items: rest.filter((p) => laneOf(p) === 'scoreboard') },
  { id: 'writing', label: 'Other', items: rest.filter((p) => laneOf(p) === 'writing') },
].filter((g) => g.items.length);
---
<Base title="Reading · dropkit" description="Collected AI reading and source summaries, separate from hands-on project notes.">
  <h1>AI 동향 자료 / Reading</h1><p>외부 자료를 모아 정리한 기록입니다. 직접 실행한 프로젝트 결과와 구분해 읽어 주세요.</p>
  <p class="meta">Some older entries use “robust” for repeated AI judgments. Agreement between runs does not establish that a claim is true. Check the linked original source for the scope and date of each claim.</p>
  {
    latest && (
      <section style="margin-bottom:2.5rem">
        <p class="meta" style="letter-spacing:0.04em;text-transform:uppercase;margin:0 0 0.75rem">
          Latest drop · {laneOf(latest)}
        </p>
        <article>
          <h1 style="font-size:1.55rem">
            <a href={`/posts/${latest.id}/`}>{latest.data.title}</a>
          </h1>
          <div class="meta">{latest.data.pubDate.toISOString().slice(0, 10)}</div>
          {latest.data.description && <p style="margin:0.5rem 0 0">{latest.data.description}</p>}
        </article>
      </section>
    )
  }
  {
    groups.map((g) => (
      <section style="margin-bottom:2.25rem">
        <h2 class="meta" style="letter-spacing:0.04em;text-transform:uppercase;margin:0 0 0.75rem">
          {g.label}
        </h2>
        {g.items.map((p) => (
          <article>
            <h1>
              <a href={`/posts/${p.id}/`}>{p.data.title}</a>
            </h1>
            <div class="meta">{p.data.pubDate.toISOString().slice(0, 10)}</div>
            {p.data.description && <p style="margin:0.5rem 0 0">{p.data.description}</p>}
          </article>
        ))}
      </section>
    ))
  }
  {posts.length === 0 && <p class="meta">No drops yet.</p>}
</Base>
